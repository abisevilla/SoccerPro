{
  "info": {
    "name": "SoccerPro API",
    "description": "Coleccion completa de la API SoccerPro. Ejecuta primero Authentication > Generate token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:59551"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestUrl = pm.request.url.toString();",
          "const isAnonymous = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (!requestUrl.includes('/api/auth/token') && !isAnonymous) {",
          "const baseUrl = pm.variables.replaceIn('{{baseUrl}}');",
          "const username = pm.variables.replaceIn('{{username}}');",
          "const password = pm.variables.replaceIn('{{password}}');",
          "pm.environment.unset('accessToken');",
          "pm.collectionVariables.unset('accessToken');",
          "pm.globals.unset('accessToken');",
          "pm.request.headers.remove('Authorization');",
          "pm.sendRequest({",
          "  url: `${baseUrl}/api/auth/token`,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({ username, password })",
          "  }",
          "}, (error, response) => {",
          "  if (error) {",
          "    console.error('No se pudo generar el token JWT:', error);",
          "    pm.environment.set('authError', String(error));",
          "    return;",
          "  }",
          "  const json = response.json();",
          "  if (response.code >= 200 && response.code < 300 && json.accessToken) {",
          "    pm.environment.set('accessToken', json.accessToken);",
          "    pm.collectionVariables.set('accessToken', json.accessToken);",
          "    pm.globals.set('accessToken', json.accessToken);",
          "    pm.environment.unset('authError');",
          "    const accessToken = pm.variables.replaceIn('{{accessToken}}');",
          "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${accessToken}` });",
          "  } else {",
          "    console.error('La autenticacion fallo:', response.text());",
          "    pm.environment.set('authError', `HTTP ${response.code}: ${response.text()}`);",
          "  }",
          "});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Generate token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.response.json();",
                  "pm.globals.set('accessToken', jsonData.accessToken);",
                  "pm.environment.set('accessToken', jsonData.accessToken);",
                  "pm.collectionVariables.set('accessToken', jsonData.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/token"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "List teams",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json().data || [];",
                  "if (data[0]) pm.environment.set('teamId', data[0].id);",
                  "if (data[1]) pm.environment.set('awayTeamId', data[1].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/teams?pageNumber=1&pageSize=10&sortBy=name&sortDirection=asc&name="
          }
        },
        {
          "name": "Get team by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        },
        {
          "name": "Create team",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.environment.set('teamId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman FC\",\n  \"city\": \"San Salvador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Update team",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman FC Updated\",\n  \"city\": \"Santa Tecla\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        },
        {
          "name": "Delete team",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "List players",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/players?pageNumber=1&pageSize=10&sortBy=name&sortDirection=asc&teamId={{teamId}}&name=&position="
          }
        },
        {
          "name": "Get player by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/players/{{playerId}}"
          }
        },
        {
          "name": "Create player",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.environment.set('playerId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              {
                "key": "Idempotency-Key",
                "value": "{{playerIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{teamId}}\",\n  \"name\": \"Postman Player\",\n  \"position\": \"Forward\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/players"
          }
        },
        {
          "name": "Update player",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Player Updated\",\n  \"position\": \"Goalkeeper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/players/{{playerId}}"
          }
        },
        {
          "name": "Delete player",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/players/{{playerId}}"
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "List matches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/matches?pageNumber=1&pageSize=10&sortBy=date&sortDirection=asc&teamId=&from=&to=&status="
          }
        },
        {
          "name": "Get match by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/matches/{{matchId}}"
          }
        },
        {
          "name": "Create match",
