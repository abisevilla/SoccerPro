        },
        {
          "name": "Delete match",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/matches/{{matchId}}"
          }
