    },
    {
      "name": "Standings",
      "item": [
        {
          "name": "Get standings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/standings"
